# Backend configuration for Floriography. Copy to .env at the project
# root and adjust if needed -- .env itself is gitignored. Every value
# below has a working default in backend/app/config/settings.py, so
# none of this is required just to run the app locally.

# Absolute or relative path to the SQLite database file.
# FLORIOGRAPHY_DB_PATH=data/processed/floriography.db

# Path to the pickled, pre-fit TF-IDF index (see `python -m app.nlp.build_artifacts`).
# FLORIOGRAPHY_TFIDF_ARTIFACT=artifacts/tfidf_index.pkl

# Comma-separated origins allowed by CORS (the Vite dev server by default).
# FLORIOGRAPHY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default number of meaning-search results returned when top_k isn't specified.
# FLORIOGRAPHY_SEARCH_TOP_K=5

# Minimum TF-IDF cosine-similarity score to count as a real match
# (below this, a result is dropped as noise -- see docs/SEARCH_METHODOLOGY.md).
# FLORIOGRAPHY_MIN_SIMILARITY=0.1
